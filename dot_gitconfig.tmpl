# Managed by chezmoi. Identity comes from the prompts answered at `chezmoi init`.
[user]
{{- if .name }}
    name = {{ .name }}
{{- end }}
    email = {{ .email }}
{{- if .signingKey }}
    signingkey = {{ .signingKey }}
{{- end }}

{{ if .signingKey -}}
[gpg]
    format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    allowedSignersFile = ~/.config/git/allowed_signers

[commit]
    gpgsign = true

[tag]
    gpgsign = true
{{ end -}}

[init]
    defaultBranch = main

[core]
    editor = nvim
    excludesfile = ~/.config/git/ignore
    pager = less -FRX

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[rebase]
    autoStash = true
    autoSquash = true

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default

[rerere]
    enabled = true

[branch]
    sort = -committerdate

[help]
    autocorrect = prompt

[alias]
    st = status --short --branch
    lg = log --oneline --graph --decorate
    last = log -1 HEAD --stat
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    wip = commit --no-verify -m "wip"

[credential "https://github.com"]
    helper = !gh auth git-credential

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
