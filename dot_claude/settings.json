{
  "env": {
    "CLAUDE_MEM_TELEMETRY": "0",
    "NX_SELF_HOSTED_REMOTE_CACHE_SERVER": "http://127.0.0.1:4380"
  },
  "enabledPlugins": {
    "workspace-console@workspace-console": true,
    "claude-mem@thedotmack": true,
    "impeccable@impeccable": true
  },
  "extraKnownMarketplaces": {
    "workspace-console": {
      "source": {
        "source": "github",
        "repo": "EltonCarreiro/workspace-console"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "theme": "dark"
}
